{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "cellartonight.com" }],
      "destination": "https://tonightnyc.com/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.cellartonight.com" }],
      "destination": "https://tonightnyc.com/:path",
      "permanent": true
    },
    { "source": "/comedians", "destination": "/comics", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/account", "destination": "/api/account-router?action=account" },
    { "source": "/api/auth/apple/callback", "destination": "/api/account-router?action=callback" },
    { "source": "/api/auth/apple/login", "destination": "/api/account-router?action=login" },
    { "source": "/api/auth/apple/native", "destination": "/api/account-router?action=native" },
    { "source": "/api/auth/google/callback", "destination": "/api/account-router?action=googleCallback" },
    { "source": "/api/auth/google/login", "destination": "/api/account-router?action=googleLogin" },
    { "source": "/api/auth/google/native", "destination": "/api/account-router?action=googleNative" },
    { "source": "/api/auth/email/request", "destination": "/api/account-router?action=emailRequest" },
    { "source": "/api/auth/email/verify", "destination": "/api/account-router?action=emailVerify" },
    { "source": "/api/auth/logout", "destination": "/api/account-router?action=logout" },
    { "source": "/api/me", "destination": "/api/account-router?action=me" },
    { "source": "/api/prefs", "destination": "/api/account-router?action=prefs" },
    { "source": "/api/lineup", "destination": "/api/lineup" },
    { "source": "/tonight", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/support", "destination": "/support.html" },
    { "source": "/cellar", "destination": "/index.html" },
    { "source": "/stand", "destination": "/index.html" },
    { "source": "/gotham", "destination": "/index.html" },
    { "source": "/nycc", "destination": "/index.html" },
    { "source": "/standupny", "destination": "/index.html" },
    { "source": "/unionhall", "destination": "/index.html" },
    { "source": "/big", "destination": "/index.html" },
    { "source": "/comics", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/photos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=3600" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/check-alerts",
      "schedule": "0 14 * * *"
    }
  ]
}
